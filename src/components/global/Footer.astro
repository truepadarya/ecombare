---
import { SITE_NAME } from "@/consts.ts";
import { sitePath } from "@/utils/site-path";
interface Props {
  /** Set to false to omit the component. */
  render?: boolean;
}
const { render = true } = Astro.props;
const links = [
  ["/", "Home"],
  ["/style-guide", "Style guide"],
  ["/example-components", "Components"],
  ["/typography-review", "Typography"],
  ["/color-review", "Colors"],
  ["/spacing-review", "Spacing & geometry"],
  ["/interaction-review", "Video & interaction"],
  ["/motion-review", "Motion"],
  ["/media-review", "Media"],
].map(([href, label]) => [sitePath(href), label]);
---

{
  render && (
    <footer class="footer_wrap text-style-small">
      <div class="footer_inner">
        <div class="footer_top">
          <a class="footer_logo" href={sitePath()} aria-label={SITE_NAME}>
            <span class="text-style-h5">{SITE_NAME}</span>
          </a>
          <nav aria-label="Reference pages">
            <ul class="footer_links">
              {links.map(([href, label]) => (
                <li>
                  <a class="footer_link" href={href}>
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
        <p>
          &copy; {new Date().getFullYear()} {SITE_NAME}
        </p>
      </div>
    </footer>
  )
}
<style is:global>
  @layer components {
    .footer_wrap {
      display: flex;
      justify-content: center;
      padding-block: var(--space-32);
      padding-inline: var(--site-margin);
      background-color: var(--background);
      color: var(--text);
    }
    .footer_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      flex-direction: column;
      gap: var(--space-32);
    }
    .footer_top {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-24) var(--space-40);
    }
    .footer_logo {
      display: block;
      height: 2rem;
      max-width: 100%;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }
    .footer_links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-24);
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .footer_link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-8);
      min-height: var(--control-icon-size);
      color: var(--text-2);
      text-decoration: none;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }
  }
</style>
