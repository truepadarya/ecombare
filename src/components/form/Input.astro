---
import type { HTMLAttributes } from "astro/types";
import { slug } from "@/utils/slug.ts";
import FieldError from "./FieldError.astro";

type InputVariant =
  | "text"
  | "first-name"
  | "last-name"
  | "email"
  | "phone"
  | "date"
  | "zip-code"
  | "number"
  | "search"
  | "password"
  | "url";

interface Props extends Omit<HTMLAttributes<"input">, "type"> {
  errorId?: string;
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Field label. Defaults to the variant name. */
  label?: string;
  /** Initial value. */
  value?: string;
  /** Input type and autofill preset. */
  variant?: InputVariant;
  /** Field shape. */
  shape?: "default" | "pill";
  /** Submitted name. Defaults to the label slug. */
  name?: string;
  /** Empty-field hint. Defaults to the variant name. */
  placeholder?: string;
  /** Require the field and mark its label. */
  required?: boolean;
  /** Visually hide the label. */
  labelHidden?: boolean;
  /** Keep the placeholder lighter than entered text. */
  placeholderWeight?: "inherit" | "regular";
}

const {
  render = true,
  errorId,
  label,
  value,
  variant = "text",
  shape = "default",
  name,
  placeholder,
  required = false,
  labelHidden = false,
  placeholderWeight = "inherit",
  class: className,
  ...rest
} = Astro.props;

type InputAttrs = HTMLAttributes<"input">;

const KINDS: Record<
  InputVariant,
  {
    label: string;
    type: NonNullable<InputAttrs["type"]>;
    mode: NonNullable<InputAttrs["inputmode"]>;
    fill: NonNullable<InputAttrs["autocomplete"]>;
  }
> = {
  text: { label: "Text", type: "text", mode: "text", fill: "on" },
  "first-name": {
    label: "First Name",
    type: "text",
    mode: "text",
    fill: "given-name",
  },
  "last-name": {
    label: "Last Name",
    type: "text",
    mode: "text",
    fill: "family-name",
  },
  email: { label: "Email", type: "email", mode: "email", fill: "email" },
  phone: { label: "Phone", type: "tel", mode: "tel", fill: "tel" },
  date: { label: "Date", type: "date", mode: "text", fill: "bday" },
  "zip-code": {
    label: "Zip Code",
    type: "text",
    mode: "numeric",
    fill: "postal-code",
  },
  number: { label: "Number", type: "number", mode: "numeric", fill: "off" },
  search: { label: "Search", type: "search", mode: "search", fill: "off" },
  password: {
    label: "Password",
    type: "password",
    mode: "text",
    fill: "current-password",
  },
  url: { label: "URL", type: "url", mode: "url", fill: "url" },
};

const kind = KINDS[variant];
const text = label ?? kind.label;
---

{
  render && (
    <label class:list={["field", "form-input", className]}>
      <span
        id={errorId ? `${errorId}-label` : undefined}
        class:list={["field-label text-style-main", labelHidden && "sr-only"]}
      >
        <span>{text}</span>
        {required && (
          <span class="field-star" aria-hidden="true">
            *
          </span>
        )}
      </span>
      <input
        class:list={[
          "field-control text-style-main",
          shape === "pill" && "pill",
        ]}
        data-placeholder-weight={
          placeholderWeight === "regular" ? "regular" : undefined
        }
        type={kind.type}
        name={name ?? slug(text)}
        placeholder={placeholder ?? text}
        inputmode={kind.mode}
        autocomplete={kind.fill}
        required={required || undefined}
        value={value}
        aria-describedby={errorId}
        aria-labelledby={errorId ? `${errorId}-label` : undefined}
        {...rest}
      />
      <FieldError id={errorId} />
    </label>
  )
}

<style is:global>
  @layer components {
    .form-input .field-control.pill {
      border-radius: var(--radius-round);
    }
  }
</style>
