---
import type { HTMLAttributes } from "astro/types";
import Button from "@/components/Button.astro";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"dialog"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Modal ID for triggers, hash links, and `?modal=`. Required. */
  id?: string;
  /** Accessible label. */
  label?: string;
  /** Modal style. */
  variant?: "small" | "side-panel" | "full-screen" | "image";
  /** Keep open in design mode. */
  preview?: boolean;
  /** Utility classes for the content body, for example edge-to-edge sections. */
  bodyClass?: string;
};

const {
  render = true,
  id,
  label,
  variant = "small",
  preview = false,
  bodyClass,
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);

if (import.meta.env.DEV && render && content && !id) {
  console.warn(
    "[lumos] <Modal> rendered without an `id`, so nothing could open it and nothing was output.",
  );
}
---

{
  render && id && content && (
    <dialog
      id={id}
      class:list={[
        "modal_wrap",
        variant !== "small" && variant,
        preview && "preview",
        className,
      ]}
      aria-label={label}
      {...rest}
    >
      <div class="modal_content">
        <Button
          class="modal_close"
          variant="close"
          emphasis="secondary"
          data-modal-close
        />
        <div class="modal_scroll" data-modal-scroll>
          <div class:list={["modal_body margin-trim", bodyClass]}>
            <Fragment set:html={content} />
          </div>
        </div>
      </div>
    </dialog>
  )
}

<script>
  for (const modal of document.querySelectorAll<HTMLDialogElement>(
    ".modal_wrap",
  )) {
    const scroll = modal.querySelector<HTMLElement>("[data-modal-scroll]");
    let opener: HTMLElement | null = null;

    const open = () => {
      if (modal.open) return;
      opener =
        document.activeElement instanceof HTMLElement
          ? document.activeElement
          : null;
      modal.showModal();
      // Reset the live scroll box: a hidden dialog can restore its previous
      // scroll offset when it becomes rendered again.
      scroll?.scrollTo({ top: 0, behavior: "instant" });
      modal.dispatchEvent(new CustomEvent("modal-open", { bubbles: true }));
    };

    modal.addEventListener("close", () => {
      modal
        .querySelectorAll<HTMLVideoElement>("video")
        .forEach((video) => video.pause());
      if (opener?.isConnected && !opener.closest("[inert]"))
        opener.focus({ preventScroll: true });
      modal.dispatchEvent(new CustomEvent("modal-close", { bubbles: true }));
    });

    let fromBackdrop = false;

    // Close exactly the focused layer. Native Escape cancellation can also
    // reach the underlying dialog after focus restoration in a dialog stack.
    modal.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      event.preventDefault();
      event.stopPropagation();
      if (!event.repeat) modal.close();
    });

    modal.addEventListener("pointerdown", (event) => {
      fromBackdrop = event.target === modal;
    });

    modal.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest("[data-modal-close]")) modal.close();
      else if (fromBackdrop && target === modal) modal.close();
      fromBackdrop = false;
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const trigger = target.closest(
        `[data-modal-open="${CSS.escape(modal.id)}"], a[href="#${CSS.escape(modal.id)}"]`,
      );
      if (!trigger) return;
      event.preventDefault();
      if (trigger instanceof HTMLElement)
        trigger.focus({ preventScroll: true });
      open();
    });

    const url = new URL(location.href);
    if (url.searchParams.get("modal") === modal.id) {
      open();
      url.searchParams.delete("modal");
      history.replaceState(history.state, "", url);
    }
  }
</script>

<style is:global>
  @layer components {
    html:has(.modal_wrap[open]) {
      overflow: hidden;
    }

    .modal_wrap {
      --_leaving: calc(var(--open-duration) * 0.7);
      --_from: 0 2rem;
      --_body: 0 0;
      --_backdrop: color-mix(in lab, black 60%, transparent);
      --_close: calc(var(--control-icon-size) + var(--space-24) * 2);
      width: 100%;
      max-width: none;
      height: 100%;
      max-height: none;
      margin: 0;
      padding: var(--site-margin);
      align-items: center;
      justify-content: center;
      background: none;
      border: 0;
      color: var(--text);
      overflow: clip;
      transition:
        display var(--_leaving) allow-discrete,
        overlay var(--_leaving) allow-discrete;

      &[open] {
        display: flex;
        transition:
          display var(--open-duration) allow-discrete,
          overlay var(--open-duration) allow-discrete;
      }

      .stacki-designer &.preview,
      &.stacki-opened {
        display: flex;
        position: fixed;
        inset: 0;
        z-index: 100;
        background-color: var(--_backdrop);
      }

      &::backdrop {
        background-color: var(--_backdrop);
        opacity: 0;
        transition: opacity var(--_leaving) var(--open-ease);
      }

      &[open]::backdrop {
        opacity: 1;
        transition: opacity var(--open-duration) var(--open-ease);
      }

      @starting-style {
        &[open]::backdrop {
          opacity: 0;
        }
      }

      &.side-panel {
        --_panel: 28rem;
        --_from: var(--_panel) 0;
        padding: 0;
        align-items: stretch;
        justify-content: end;
      }

      &.full-screen {
        --_from: 0 0;
        --_body: 0 2rem;
        padding: 0;
        align-items: stretch;
      }
      &.image {
        --_backdrop: color-mix(in srgb, var(--dark-900) 24%, transparent);
        padding: var(--space-24);
      }
    }

    .modal_content {
      position: relative;
      display: flex;
      flex-direction: column;
      width: 100%;
      max-width: 34rem;
      max-height: 100%;
      background-color: var(--background);
      border-radius: var(--radius-main);
      overflow: hidden;
      opacity: 0;
      translate: var(--_from);
      transition:
        opacity var(--_leaving) var(--open-ease),
        translate var(--_leaving) var(--open-ease);

      .modal_wrap.side-panel & {
        max-width: var(--_panel);
        max-height: none;
        border-radius: 0;
      }

      .modal_wrap.full-screen & {
        max-width: none;
        max-height: none;
        border-radius: 0;
      }
      .modal_wrap.image & {
        width: fit-content;
        max-width: min(56.625rem, 100%);
        background: transparent;
      }

      .modal_wrap:is([open], .stacki-opened) &,
      .stacki-designer .modal_wrap.preview & {
        opacity: 1;
        translate: 0 0;
        transition:
          opacity var(--open-duration) var(--open-ease),
          translate var(--open-duration) var(--open-ease);
      }

      @starting-style {
        .modal_wrap[open] & {
          opacity: 0;
          translate: var(--_from);
        }
      }
    }

    .modal_close {
      position: absolute;
      top: var(--space-24);
      inset-inline-end: var(--space-24);
      z-index: 1;
    }

    .modal_scroll {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;

      .modal_wrap.full-screen & {
        height: 100%;
      }
    }

    .modal_body {
      padding: var(--_close) var(--space-40) var(--space-48);
      translate: var(--_body);
      transition: translate var(--_leaving) var(--open-ease);

      .modal_wrap.full-screen & {
        min-height: 100%;
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-content: center;
      }

      .modal_wrap:is([open], .stacki-opened) &,
      .stacki-designer .modal_wrap.preview & {
        translate: 0 0;
        transition: translate var(--open-duration) var(--open-ease);
      }

      @starting-style {
        .modal_wrap[open] & {
          translate: var(--_body);
        }
      }
    }
  }
</style>
