---
import type { HTMLAttributes } from "astro/types";
import Button from "@/components/Button.astro";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Accessible label. Defaults to `Slider`. */
  label?: string;
  /** Slider bounds. */
  variant?: "bleed" | "crop-start" | "contained";
  /** Show navigation buttons and slide indicators. Keyboard and swipe remain available. */
  showControls?: boolean;
  /** Show slide indicators alongside the navigation buttons. */
  showIndicators?: boolean;
  /** Disable snapping for a row controlled by vertical scroll progress. */
  snap?: boolean;
  /** Slides shown below 30rem. Defaults to `1.02`.
   *
   * @min 1
   * @max 12 */
  xsmall?: number;
  /** Slides shown from 30rem. Inherits `xsmall`.
   *
   * @min 1
   * @max 12 */
  small?: number;
  /** Slides shown from 48rem. Inherits `small`.
   *
   * @min 1
   * @max 12 */
  medium?: number;
  /** Slides shown from 64rem. Inherits `medium`.
   *
   * @min 1
   * @max 12 */
  large?: number;
};

const {
  render = true,
  label = "Slider",
  variant = "bleed",
  showControls = true,
  showIndicators = true,
  snap = true,
  xsmall = 1.02,
  small,
  medium,
  large,
  class: className,
  ...rest
} = Astro.props;

const counts = { xs: xsmall, sm: small, md: medium, lg: large };

const invalid = Object.entries(counts).filter(
  ([, count]) => count !== undefined && !(Number.isFinite(count) && count > 0),
);

if (import.meta.env.DEV && invalid.length) {
  console.warn(
    `[lumos] <Slider> ignores ${invalid.map(([size]) => size).join(", ")}: slides in view must be greater than 0.`,
  );
}

const set = (count: number | undefined) =>
  count !== undefined && Number.isFinite(count) && count > 0;

const visible =
  [
    xsmall !== 1.02 && set(xsmall) && `--_visible-xs: ${xsmall}`,
    set(small) && `--_visible-sm: ${small}`,
    set(medium) && `--_visible-md: ${medium}`,
    set(large) && `--_visible-lg: ${large}`,
  ]
    .filter(Boolean)
    .join("; ") || undefined;

const slides = await slotContent(Astro.slots);
---

{
  render && slides && (
    <div
      class:list={[
        "slider_wrap",
        variant !== "bleed" && variant,
        !snap && "free-scroll",
        className,
      ]}
      style={visible}
      {...rest}
    >
      <div class="slider_list" role="group" aria-label={label} tabindex="0">
        <Fragment set:html={slides} />
      </div>

      {showControls && (
        <div
          class:list={[
            "slider_controls",
            !showIndicators && "justify-content-center",
          ]}
        >
          {showIndicators && <div class="slider_markers" />}
          <div class="slider_steps">
            <Button
              variant="arrow"
              emphasis="secondary"
              direction="back"
              label="Previous slide"
              data-step="-1"
            />
            <Button
              variant="arrow"
              emphasis="secondary"
              label="Next slide"
              data-step="1"
            />
          </div>
        </div>
      )}
    </div>
  )
}

<script>
  for (const slider of document.querySelectorAll<HTMLElement>(".slider_wrap")) {
    const list = slider.querySelector<HTMLElement>(".slider_list");
    const markers = slider.querySelector<HTMLElement>(".slider_markers");
    const controls = slider.querySelector<HTMLElement>(".slider_controls");
    const steps = [
      ...slider.querySelectorAll<HTMLButtonElement>("[data-step]"),
    ];
    if (!list) continue;

    const slides = [...list.children].filter(
      (slide) => !slide.matches("script, style, template"),
    ) as HTMLElement[];
    if (slides.length === 0) continue;

    slides.forEach((slide, i) => {
      if (!slide.matches("button, a")) slide.setAttribute("role", "group");
      if (!slide.hasAttribute("aria-label"))
        slide.setAttribute("aria-label", `${i + 1} of ${slides.length}`);
    });

    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const behavior = () => (reduced.matches ? "auto" : "smooth");
    let destination: number | null = null;

    const positions = () => {
      const end = list.scrollWidth - list.clientWidth;
      const first = slides[0].getBoundingClientRect();
      const offsets = slides.map((slide) =>
        Math.min(
          end,
          Math.abs(slide.getBoundingClientRect().left - first.left),
        ),
      );
      return offsets.filter(
        (offset, index) =>
          index === 0 || Math.abs(offset - offsets[index - 1]) > 1,
      );
    };
    const current = () => {
      const offset = Math.abs(list.scrollLeft);
      return positions().reduce(
        (closest, target, index, targets) =>
          Math.abs(target - offset) < Math.abs(targets[closest] - offset)
            ? index
            : closest,
        0,
      );
    };
    const goTo = (index: number, motion: ScrollBehavior = behavior()) => {
      const targets = positions();
      destination = Math.max(0, Math.min(targets.length - 1, index));
      const target = targets[destination];
      const direction = getComputedStyle(list).direction === "rtl" ? -1 : 1;
      list.scrollTo({ left: direction * target, behavior: motion });
    };
    list.addEventListener("keydown", (event) => {
      if (event.target !== list) return;
      const rtl = getComputedStyle(list).direction === "rtl";
      switch (event.key) {
        case "ArrowRight":
          goTo(current() + (rtl ? -1 : 1), "instant");
          break;
        case "ArrowLeft":
          goTo(current() + (rtl ? 1 : -1), "instant");
          break;
        case "Home":
          goTo(0, "instant");
          break;
        case "End":
          goTo(positions().length - 1, "instant");
          break;
        default:
          return;
      }
      event.preventDefault();
    });

    let drawn = 0;

    const draw = (total: number) => {
      drawn = total;
      if (!markers) return;
      markers.replaceChildren(
        ...Array.from({ length: total }, (_, i) => {
          const marker = document.createElement("button");
          marker.type = "button";
          marker.className = "slider_marker";
          marker.setAttribute("aria-label", `Go to slide ${i + 1}`);
          marker.addEventListener("click", () => goTo(i));
          return marker;
        }),
      );
    };

    const sync = () => {
      const total = positions().length;
      if (total !== drawn) draw(total);

      const end = list.scrollWidth - list.clientWidth;
      const atStart = Math.abs(list.scrollLeft) <= 1;
      const atEnd = Math.abs(list.scrollLeft) >= end - 1;

      for (const step of steps) {
        step.disabled = Number(step.dataset.step) < 0 ? atStart : atEnd;
      }

      const index = current();
      markers?.querySelectorAll(".slider_marker").forEach((marker, i) => {
        marker.classList.toggle("is-active", i === index);
        if (i === index) marker.setAttribute("aria-current", "true");
        else marker.removeAttribute("aria-current");
      });

      controls?.classList.toggle("is-empty", end <= 1);
    };

    for (const step of steps) {
      step.addEventListener("click", () =>
        goTo((destination ?? current()) + Number(step.dataset.step)),
      );
    }
    const clearDestination = () => {
      destination = null;
    };
    list.addEventListener("scrollend", clearDestination);
    list.addEventListener("wheel", clearDestination, { passive: true });
    list.addEventListener("touchstart", clearDestination, { passive: true });
    list.addEventListener("dragstart", (event) => event.preventDefault());

    let frame = 0;
    list.addEventListener(
      "scroll",
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(sync);
      },
      { passive: true },
    );

    slider.classList.add("is-ready");

    const resize = new ResizeObserver(() => {
      clearDestination();
      sync();
    });
    resize.observe(list);

    addEventListener("load", sync);
    document.addEventListener(
      "astro:before-swap",
      () => {
        resize.disconnect();
        cancelAnimationFrame(frame);
        window.removeEventListener("load", sync);
      },
      { once: true },
    );
    sync();
  }
</script>

<style is:global>
  @layer components {
    .slider_wrap {
      --_gap-size: var(--site-gutter);
      --_edge: max(var(--site-margin), (100vw - var(--max-width-main)) / 2);
      --_visible: var(--_visible-xs);
      --_visible-xs: 1.02;
      --_visible-sm: var(--_visible-xs);
      --_visible-md: var(--_visible-sm);
      --_visible-lg: var(--_visible-md);
      display: grid;
      gap: var(--space-40);
      width: 100%;

      @media (width >= 30rem) {
        --_visible: var(--_visible-sm);
      }
      @media (width >= 48rem) {
        --_visible: var(--_visible-md);
      }
      @media (width >= 64rem) {
        --_visible: var(--_visible-lg);
      }
    }

    .slider_list {
      display: flex;
      gap: var(--_gap-size);
      min-width: 0;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      .slider_wrap.free-scroll & {
        scroll-snap-type: none;
      }
      overscroll-behavior-x: contain;
      touch-action: pan-x pan-y pinch-zoom;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--_edge));
      padding-inline: var(--_edge);
      scroll-padding-inline: var(--_edge);

      &::-webkit-scrollbar {
        display: none;
      }

      & > :not(script, style, template) {
        flex: 0 0
          calc(
            (100% - (var(--_visible) - 1) * var(--_gap-size)) / var(--_visible)
          );
        min-width: 0;
        scroll-snap-align: start;
      }

      .slider_wrap.crop-start & {
        margin-inline-start: 0;
        padding-inline-start: 0;
        scroll-padding-inline-start: 0;
      }

      .slider_wrap.contained & {
        margin-inline: 0;
        padding-inline: 0;
        scroll-padding-inline: 0;
      }
    }

    .slider_controls {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-24);

      .slider_wrap:not(.is-ready) &,
      &.is-empty {
        display: none;
      }
    }

    .slider_markers {
      display: flex;
      flex-wrap: wrap;
      min-width: 0;
      align-items: center;
      gap: var(--space-4);
    }

    .slider_marker {
      display: grid;
      place-items: center;
      width: var(--control-icon-size);
      height: var(--control-icon-size);
      padding: 0;
      border: 0;
      background: none;
      &::before {
        content: "";
        width: 0.75rem;
        height: 0.75rem;
        border: var(--border-width) solid var(--text);
        border-radius: var(--radius-round);
        transition: background-color var(--hover-duration) var(--hover-ease);
      }
      &.is-active::before {
        background-color: var(--text);
      }
      @media (hover: hover) {
        &:hover::before {
          background-color: var(--text);
        }
      }
    }

    .slider_steps {
      display: flex;
      gap: var(--space-12);
    }
  }
</style>
