---
import Section from "@/components/wrapper/Section.astro";
import Slider from "@/components/interactive/Slider.astro";

import Img from "@/components/media/Img.astro";
import { getMediaAlt } from "@/utils/media";
import type { CaseDetail } from "@/data/cases";
interface Props {
  detail: CaseDetail;
}
const { detail } = Astro.props;
---

<div
  class="case-photo-scroll position-relative width-full"
  data-case-photo-scroll
>
  <div
    class="case-photo-stage width-full flex-vertical-nowrap align-items-stretch"
  >
    <slot />
    <Section paddingTop="none" aria-label={`${detail.title} gallery`}>
      <Slider
        label={`${detail.title} photos`}
        showControls={false}
        snap={false}
        xsmall={1.45}
        small={1.9}
        medium={2.4}
        large={3.12}
      >
        {
          detail.gallery.map((photo, index) => (
            <button
              type="button"
              class="case-photo position-relative radius-main overflow-hidden"
              data-modal-open={`case-photo-${detail.id}-${index}`}
              aria-controls={`case-photo-${detail.id}-${index}`}
              aria-haspopup="dialog"
              aria-label={`Open photo ${index + 1}: ${getMediaAlt(photo.image)}`}
            >
              <Img
                src={photo.image}
                variant="constrained"
                sizes="(min-width: 64rem) 32vw, (min-width: 48rem) 42vw, (min-width: 30rem) 52vw, 70vw"
                class="cover-absolute object-fit-cover"
                alt=""
                style={
                  photo.position
                    ? `object-position: ${photo.position}`
                    : undefined
                }
              />
            </button>
          ))
        }
      </Slider>
    </Section>
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-case-photo-scroll]",
  )) {
    const stage = root.querySelector<HTMLElement>(".case-photo-stage")!;
    const list = root.querySelector<HTMLElement>(".slider_list")!;
    const section = list.closest<HTMLElement>("section")!;
    const modal = root.closest<HTMLDialogElement>("dialog")!;
    const scroll = root.closest<HTMLElement>("[data-modal-scroll]")!;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const desktop = matchMedia("(min-width: 64rem)");
    const controller = new AbortController(),
      { signal } = controller;
    let start = 0,
      travel = 0,
      pinned = false,
      frame = 0;
    const clamp = (n: number) => Math.max(0, Math.min(travel, n));
    const draw = () => {
      frame = 0;
      if (!pinned) return;
      const x = clamp(scroll.scrollTop - start);
      if (Math.abs(list.scrollLeft - x) > 1) list.scrollLeft = x;
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(draw);
    };
    const measure = () => {
      if (!modal.open) return;
      const height = scroll.clientHeight;
      const style = getComputedStyle(section);
      const available =
        height - parseFloat(style.paddingTop) - parseFloat(style.paddingBottom);
      const limit = Math.floor((available * 411) / 460);
      const readable =
        limit >=
        12 * parseFloat(getComputedStyle(document.documentElement).fontSize);
      if (readable && !reduced.matches)
        root.style.setProperty("--_photo-limit", `${limit}px`);
      else root.style.removeProperty("--_photo-limit");
      const needed =
        list.offsetHeight +
        parseFloat(style.paddingTop) +
        parseFloat(style.paddingBottom);
      travel = Math.max(0, list.scrollWidth - list.clientWidth);
      pinned =
        desktop.matches && !reduced.matches && needed <= height && travel > 0;
      root.toggleAttribute("data-pinned", pinned);
      const stageHeight = stage.offsetHeight;
      const top = height - stageHeight;
      start =
        root.getBoundingClientRect().top -
        root.closest<HTMLElement>(".modal_body")!.getBoundingClientRect().top -
        top;
      if (pinned) {
        stage.style.top = `${top}px`;
        root.style.height = `${stageHeight + travel}px`;
      } else {
        stage.style.removeProperty("top");
        root.style.removeProperty("height");
      }
      draw();
    };
    scroll.addEventListener("scroll", schedule, { passive: true, signal });
    list.addEventListener(
      "scroll",
      () => {
        if (
          pinned &&
          scroll.scrollTop >= start - 1 &&
          scroll.scrollTop <= start + travel + 1 &&
          Math.abs(list.scrollLeft - clamp(scroll.scrollTop - start)) > 1
        )
          scroll.scrollTo({
            top: start + list.scrollLeft,
            behavior: "instant",
          });
      },
      { passive: true, signal },
    );
    modal.addEventListener(
      "modal-open",
      () => {
        measure();
        list.scrollTo({ left: 0, behavior: "instant" });
      },
      { signal },
    );
    const resize = new ResizeObserver(measure);
    resize.observe(list);
    reduced.addEventListener("change", measure, { signal });
    desktop.addEventListener("change", measure, { signal });
    addEventListener("resize", measure, { passive: true, signal });
    document.addEventListener(
      "astro:before-swap",
      () => {
        controller.abort();
        resize.disconnect();
        cancelAnimationFrame(frame);
      },
      { once: true },
    );
  }
</script>
<style is:global>
  @layer components {
    .case-photo {
      aspect-ratio: 411 / 460;
      max-width: var(--_photo-limit, none);
    }
    .case-photo-scroll[data-pinned] .case-photo-stage {
      position: sticky;
      top: 0;
    }
  }
</style>
