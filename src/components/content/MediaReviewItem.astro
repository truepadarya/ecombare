---
import { getMediaAlt, getMediaDescription } from "@/utils/media";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Original file URL. */
  src: string;
  /** File path relative to graphics. */
  name: string;
  /** File size in bytes. */
  bytes: number;
  /** Image or video width. */
  width: number;
  /** Image or video height. */
  height: number;
  /** Whether the file is a video. */
  video?: boolean;
  /** Video poster URL. */
  poster?: string;
}

const {
  render = true,
  src,
  name,
  bytes,
  width,
  height,
  video = false,
  poster,
} = Astro.props;
const metadata = getMediaDescription(src);
const size =
  bytes >= 1024 * 1024
    ? `${(bytes / 1024 / 1024).toFixed(2)} МиБ`
    : `${Math.round(bytes / 1024)} КиБ`;
---

{
  render && src && (
    <figure class="media-review_wrap" data-media-id={metadata?.id}>
      <div class="media-review_preview">
        {video ? (
          <video
            class="media-review_visual"
            src={src}
            poster={poster}
            width={width}
            height={height}
            controls
            muted
            playsinline
            preload="none"
            aria-label={metadata?.description}
          />
        ) : (
          <a
            class="media-review_open"
            href={src}
            target="_blank"
            rel="noopener"
            aria-label={`Открыть: ${metadata?.description ?? name}`}
          >
            <img
              class="media-review_visual"
              src={src}
              alt={getMediaAlt(src)}
              width={width}
              height={height}
              loading="lazy"
              decoding="async"
            />
          </a>
        )}
      </div>
      <figcaption class="media-review_caption text-style-small">
        <span class="media-review_name">{name}</span>
        <span class="media-review_details">
          {width} × {height} · {size}
        </span>
        {metadata && <span lang="en">{metadata.description}</span>}
        {metadata?.decorative && <span>Декоративное изображение · alt=""</span>}
        <a href={src} target="_blank" rel="noopener">
          Открыть файл ↗
        </a>
      </figcaption>
    </figure>
  )
}

<style is:global>
  @layer components {
    .media-review_wrap {
      margin: 0;
      min-width: 0;
      align-self: start;
      overflow: hidden;
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
    }

    .media-review_preview {
      display: grid;
      align-items: center;
      min-height: 20rem;
      background-color: var(--background-2);
      background-image: repeating-conic-gradient(
        var(--background-2) 0% 25%,
        var(--background) 0% 50%
      );
      background-size: 1.5rem 1.5rem;
    }

    .media-review_open {
      display: block;
      width: 100%;
    }

    .media-review_visual {
      display: block;
      width: 100%;
      height: auto;
      max-height: 48rem;
      object-fit: contain;
    }

    .media-review_caption {
      display: flex;
      flex-direction: column;
      align-items: start;
      gap: var(--space-8);
      padding: var(--space-24);
      overflow-wrap: anywhere;
    }

    .media-review_name {
      font-family: var(--primary-family);
    }

    .media-review_details {
      opacity: 0.7;
    }
  }
</style>
