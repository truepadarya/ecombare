---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";
import type { SpacingStep } from "@/data/spacing";

type SectionSpace =
  "none" | "even" | "small" | "medium" | "large" | "navoverlap";

type ContainerGap = "0" | SpacingStep | "small" | "medium" | "large";

interface Props extends HTMLAttributes<"section"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Color theme of element and its children. */
  theme?: "inherit" | "light" | "dark" | "brand";
  /** Top padding. */
  paddingTop?: SectionSpace;
  /** Bottom padding. */
  paddingBottom?: SectionSpace;
  /** Override bottom spacing below the shared phone breakpoint. */
  mobilePaddingBottom?: SectionSpace;
  /** Child gap. */
  gap?: ContainerGap;
  /** Content alignment. */
  align?: "start" | "center" | "end";
  /** Fill the viewport height. */
  fullHeight?: boolean;
  /** Inner container classes. */
  containerClass?: string;
  /** Inner container attributes. */
  containerAttrs?: HTMLAttributes<"div">;
}

const {
  render = true,
  theme = "inherit",
  paddingTop = "medium",
  paddingBottom = "medium",
  mobilePaddingBottom,
  gap = "64",
  align,
  fullHeight = false,
  containerClass,
  containerAttrs = {},
  class: className,
  style,
  ...rest
} = Astro.props;

const { class: containerAttrsClass, ...containerRest } = containerAttrs;

const padSuffix: Partial<Record<SectionSpace, string>> = {
  none: "0",
  even: "sitemargin",
};

const padClass = (side: "top" | "bottom", value: SectionSpace) =>
  !!value &&
  value !== "medium" &&
  `padding-${side}-${padSuffix[value] ?? value}`;

const content = await slotContent(Astro.slots);
const background = await slotContent(Astro.slots, "background");
const spaceValue = (space: SectionSpace) =>
  space === "none"
    ? "0rem"
    : space === "even"
      ? "var(--site-margin)"
      : `var(--section-space-${space === "navoverlap" ? "nav-overlap" : space})`;
---

{
  render && (content || background) && (
    <section
      class:list={[
        "section",
        padClass("top", paddingTop),
        !mobilePaddingBottom && padClass("bottom", paddingBottom),
        fullHeight && "min-height-screen",
        theme !== "inherit" && `theme-${theme}`,
        align && `alignment-${align}`,
        className,
      ]}
      {...rest}
      data-mobile-bottom={mobilePaddingBottom ? "" : undefined}
      style={
        mobilePaddingBottom
          ? `${style ?? ""};--_bottom-space:${spaceValue(paddingBottom)};--_mobile-bottom:${spaceValue(mobilePaddingBottom)};`
          : style
      }
    >
      <Fragment set:html={background} />
      {content && (
        <div
          class:list={[
            "container",
            gap !== "64" && `gap-${gap}`,
            containerClass,
            containerAttrsClass,
          ]}
          {...containerRest}
        >
          <Fragment set:html={content} />
        </div>
      )}
    </section>
  )
}

<style is:global>
  @layer components {
    .section[data-mobile-bottom] {
      padding-bottom: var(--_bottom-space);
    }
    @media (width < 48rem) {
      .section[data-mobile-bottom] {
        padding-bottom: var(--_mobile-bottom);
      }
    }
  }
</style>
